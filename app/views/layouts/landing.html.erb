<!DOCTYPE html>
<html lang="id" class="motion-safe:scroll-smooth">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= landing_text('page_title') %></title>
    <meta name="description" content="<%= landing_text('page_description') %>">
    <meta name="theme-color" content="#10213A">
    <meta property="og:title" content="<%= landing_text('page_title') %>">
    <meta property="og:description" content="<%= landing_text('page_description') %>">
    <meta property="og:type" content="website">
    <link rel="icon" href="/favicon-32x32.png" type="image/png">
    <link rel="preload" href="/brand-assets/plus-jakarta-sans-latin.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/brand-assets/source-sans-3-latin.woff2" as="font" type="font/woff2" crossorigin>
    <%= vite_client_tag %>
    <%= vite_stylesheet_tag 'landing.css' %>
  </head>
  <body class="bg-white font-landing-body text-landing-ink antialiased selection:bg-landing-orange/20">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:start-4 focus:top-4 focus:z-20 focus:rounded-full focus:bg-white focus:px-6 focus:py-3 focus:ring-2 focus:ring-landing-green"><%= landing_text('skip_navigation') %></a>
    <%= yield %>
  </body>
</html>
